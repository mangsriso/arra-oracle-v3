{
  "name": "arra-oracle-v3",
  "version": "26.5.2-alpha.1704",
  "description": "Arra Oracle - MCP Memory Layer with semantic search, philosophy, and knowledge management",
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "arra-oracle-v3": "./bin/arra.ts",
    "arra-oracle-v2": "./src/index.ts",
    "arra-cli": "./cli/src/cli.ts"
  },
  "files": [
    "bin",
    "src",
    "cli",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Soul-Brews-Studio/arra-oracle-v2.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "\"$npm_execpath\" src/index.ts",
    "server": "\"$npm_execpath\" src/server.ts",
    "vector": "ORACLE_VECTOR_READONLY=1 \"$npm_execpath\" src/vector-server.ts",
    "vector:dev": "ORACLE_VECTOR_READONLY=1 \"$npm_execpath\" --watch src/vector-server.ts",
    "server:ensure": "\"$npm_execpath\" src/ensure-server.ts",
    "server:status": "\"$npm_execpath\" src/ensure-server.ts --status",
    "serve": "\"$npm_execpath\" dist/server.js",
    "index": "\"$npm_execpath\" src/indexer/cli.ts",
    "backup:create": "\"$npm_execpath\" src/indexer/backup-cli.ts create",
    "backup:verify": "\"$npm_execpath\" src/indexer/backup-cli.ts verify",
    "verify:index": "\"$npm_execpath\" src/verify/cli.ts",
    "build": "tsc --noEmit",
    "start": "\"$npm_execpath\" dist/index.js",
    "test": "\"$npm_execpath\" run test:unit && \"$npm_execpath\" run test:integration && \"$npm_execpath\" run test:e2e:a2",
    "test:unit": "\"$npm_execpath\" test src/learn/__tests__/ src/tools/__tests__/ src/server/__tests__/ src/vault/__tests__/ src/routes/health/__tests__/ src/routes/feed/__tests__/ src/routes/knowledge/__tests__/ src/indexer/__tests__/ src/scripts/__tests__/ src/testing/__tests__/ src/verify/__tests__/ src/vector/__tests__/lancedb-incremental.test.ts src/vector/__tests__/lancedb-precomputed-vectors.test.ts src/drizzle-migration.test.ts src/indexer-preservation.test.ts",
    "test:integration": "\"$npm_execpath\" test src/integration/",
    "test:integration:db": "\"$npm_execpath\" test src/integration/database.test.ts",
    "test:integration:mcp": "\"$npm_execpath\" test src/integration/mcp.test.ts",
    "test:integration:http": "\"$npm_execpath\" test src/integration/http.test.ts",
    "test:e2e:a2": "\"$npm_execpath\" test --max-concurrency 1 tests/e2e/arra-*.test.ts",
    "test:http": "\"$npm_execpath\" test --max-concurrency 1 tests/http/",
    "test:seed": "\"$npm_execpath\" scripts/seed-test-data.ts",
    "test:coverage": "\"$npm_execpath\" test --coverage",
    "db:generate": "\"$npm_execpath\" x drizzle-kit generate",
    "db:migrate": "\"$npm_execpath\" x drizzle-kit migrate",
    "db:push": "\"$npm_execpath\" x drizzle-kit push",
    "db:pull": "\"$npm_execpath\" x drizzle-kit pull",
    "db:studio": "\"$npm_execpath\" x drizzle-kit studio",
    "setup": "./scripts/setup.sh",
    "vault:init": "\"$npm_execpath\" src/vault/cli.ts init",
    "vault:sync": "\"$npm_execpath\" src/vault/cli.ts sync",
    "vault:pull": "\"$npm_execpath\" src/vault/cli.ts pull",
    "vault:status": "\"$npm_execpath\" src/vault/cli.ts status",
    "vault:migrate": "\"$npm_execpath\" src/vault/cli.ts migrate",
    "vault:rsync": "./scripts/vault-rsync.sh"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.1",
    "@elysiajs/swagger": "^1.3.1",
    "@lancedb/lancedb": "^0.27.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@qdrant/js-client-rest": "^1.17.0",
    "commander": "^14.0.3",
    "drizzle-orm": "^0.45.2",
    "elysia": "^1.4.28",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.17.9",
    "better-sqlite3": "^12.9.0",
    "bun-types": "^1.3.12",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.7.2"
  },
  "keywords": [
    "oracle",
    "mcp",
    "memory",
    "knowledge-base",
    "semantic-search"
  ],
  "author": "Nat's Agents",
  "license": "BUSL-1.1"
}
